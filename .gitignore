# machine-specific config
config.json

# runtime state (regenerated each session)
logs/status.json
logs/_next.json
logs/_patch.json
logs/_rename.json
logs/_inspect.json
logs/_serve.log
logs/*.tmp

# large generated media — excluded so your agent's output stays on your machine.
image/*
video/*
# ...except two sample journeys that ship with the repo (渡 · cross and
# 箱 · case), so the viewer has something to play on a fresh clone.
!image/渡-j1-*
!video/渡-j1-*
!image/箱-j1-*
!video/箱-j1-*

# Claude Code / editor local settings
.claude/settings.local.json
.claude/settings.json
.claude/launch.json

# Python
__pycache__/
*.pyc
driver/__pycache__/

# workflow backup
workflows/*.bak

# Author's private backup folder (not for public repo)
from_other_machine/

# exported videos — gitignored so personal output stays local
exports/

# OS
.DS_Store
Thumbs.db
